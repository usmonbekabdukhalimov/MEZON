{
  "name": "mezon", "main": "src/worker.js", "compatibility_date": "2026-10-18",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "mezon", "database_id": "REPLACE_WITH_REAL_D1_ID", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "ORIGINALS", "bucket_name": "mezon-originals"}, {"binding": "BACKUPS", "bucket_name": "mezon-backups"}],
  "vars": {"SUPABASE_URL": "https://REPLACE.supabase.co", "SUPABASE_PUBLISHABLE_KEY": "REPLACE_WITH_PUBLISHABLE_KEY"}
}
